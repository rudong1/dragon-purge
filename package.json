{
  "name": "dragon-purge-desktop-pet",
  "productName": "白龙娘桌宠",
  "version": "0.4.0",
  "description": "A white dragon desktop companion with pose switching, desktop shortcuts and GitHub release updates.",
  "private": true,
  "main": "desktop/main.cjs",
  "license": "UNLICENSED",
  "author": "rudong1",
  "repository": {
    "type": "git",
    "url": "https://github.com/rudong1/dragon-purge.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js --no",
    "start": "electron .",
    "test": "node --test --experimental-test-isolation=none desktop/test/*.test.cjs",
    "icons": "node scripts/build-icons.cjs",
    "pack": "npm run icons && electron-builder --dir",
    "dist:win": "npm run icons && electron-builder --win nsis --x64",
    "dist:linux": "npm run icons && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "js-yaml": "4.3.2",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5"
  }
}
